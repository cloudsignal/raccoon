{
  "name": "@raccoon/connector-nanoclaw",
  "version": "0.1.0",
  "description": "NanoClaw channel connector for Raccoon: embeds the raccoon endpoint (hub, pairing, PWA) in the NanoClaw host process as a ChannelAdapter, shipped as a bundle plus an add-raccoon skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudsignal/raccoon.git",
    "directory": "adapters/connector-nanoclaw"
  },
  "homepage": "https://github.com/cloudsignal/raccoon#readme",
  "bugs": "https://github.com/cloudsignal/raccoon/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@raccoon/bridge": "0.1.0",
    "@raccoon/pairing": "0.1.0",
    "@raccoon/protocol": "0.1.0",
    "@raccoon/push": "0.1.0",
    "@raccoon/transport-ws": "0.1.0",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "skill", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs"
  }
}
